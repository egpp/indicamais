# Copie para .env.local (dev) e preencha. Nunca comite valores reais.
# Em Cloudflare, segredos entram como secrets do Worker; localmente, em .dev.vars.

# Supabase (projeto de DESENVOLVIMENTO; producao tem projeto proprio, D-003)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca em codigo de cliente, log ou relatorio.
SUPABASE_SERVICE_ROLE_KEY=

# Aplicacao
# Endereco publico do app (https://...). Usado nas URLs absolutas da previa no WhatsApp (Open Graph).
# Endereço público (https://...). Sem ela, as páginas públicas omitem og:url e og:image.
NEXT_PUBLIC_APP_URL=
APP_ENV=
# Paginas publicas (home, perfil, item): sem esta variavel ficam com noindex/nofollow.
# Abrir ao publico e decisao do Emerson (IM-089): so o valor "sim" libera a indexacao.
PUBLICO_INDEXAVEL=

# E-mail transacional: Resend (plano gratis: 3.000/mes, 100/dia, 1 dominio). Somente servidor.
# Sem EMAIL_API_KEY o aviso por e-mail fica "pendente" (sem erro). Nunca comite valores.
EMAIL_API_KEY=
# Remetente de dominio verificado no Resend, ex.: IndicaMais <avisos@seudominio.com.br>
EMAIL_FROM=

# Login social (Fase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Testes e2e (Playwright, D-011): contas de teste do ambiente de DESENVOLVIMENTO.
# Preencher so em .env.local. Nunca usar contas reais nem de producao.
E2E_DONO_EMAIL=
E2E_DONO_SENHA=
E2E_INDICADOR_EMAIL=
E2E_INDICADOR_SENHA=
E2E_ADMIN_EMAIL=
E2E_ADMIN_SENHA=

# Protecao dos formularios publicos (contato e denuncia; RSA-05, RSA-07, D-033). Somente nomes; nunca comite valores.
# Turnstile da Cloudflare (gratis): crie um widget no painel Cloudflare (Turnstile) com o dominio do site.
# Chave do site (publica; vai para o navegador; precisa estar definida na hora do build).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Chave secreta (SOMENTE servidor/Worker). Sem ela, em producao o envio e recusado (falha fechado); em pnpm dev e dispensada.
TURNSTILE_SECRET_KEY=
# Segredo do HMAC do hash de origem (IP + navegador) da denuncia e do contato. SOMENTE servidor/Worker. Gere com: openssl rand -hex 32
# (minimo 32 caracteres). Sem ele, em producao o envio e recusado; em pnpm dev a origem fica vazia.
DENUNCIA_HASH_SEGREDO=
