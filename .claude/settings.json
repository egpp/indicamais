{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "jarvis",
  "permissions": {
    "allow": [
            "Bash(git init*)",
      "Bash(git remote -v)",
      "Bash(git remote add *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",
      "Bash(gh auth status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(supabase --version)",
      "Bash(supabase link *)",

      "Bash(pnpm *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch)",
      "Bash(git push *)",
      "Bash(supabase start*)",
      "Bash(supabase status*)",
      "Bash(supabase migration *)",
      "Bash(supabase gen types *)"
    ],
    "ask": [
      "Bash(gh repo create*)",
      "Bash(gh pr merge*)",
      "Bash(git push origin main*)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db push *)",
      "Bash(pnpm dlx supabase db push *)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(pnpm run deploy*)",
      "Bash(pnpm deploy*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(supabase db reset *)",
      "Bash(npx supabase db reset *)",
      "Bash(pnpm dlx supabase db reset *)",
      "Bash(supabase projects delete *)",
      "Bash(npx supabase projects delete *)",
      "Bash(wrangler delete *)",
      "Bash(npx wrangler delete *)",
      "Bash(wrangler pages project delete *)",
      "Bash(npx wrangler pages project delete *)",
      "Bash(wrangler d1 delete *)",
      "Bash(wrangler kv namespace delete *)",
      "Bash(wrangler r2 bucket delete *)",
      "Bash(gh repo delete *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.dev.vars)"
    ]
  }
}
